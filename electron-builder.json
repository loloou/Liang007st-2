{
  "appId": "com.liang007.studio",
  "productName": "liang007生图",
  "asar": true,
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/**/*",
    "client/dist/**/*",
    "client/public/static/**/*",
    "client/public/infinite-canvas/**/*",
    "logo.ico"
  ],
  "extraResources": [
    {
      "from": "electron/resources",
      "to": "resources",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "logo.ico",
    "signAndEditExecutable": false
  },
  "portable": {
    "artifactName": "liang007生图_v${version}.exe"
  }
}
